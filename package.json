{
  "name": "tft-assistant-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "data:update": "tsx scripts/update-data.ts",
    "data:static": "tsx scripts/update-data.ts",
    "data:patch": "tsx scripts/update-patch-data.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "test": "tsx --test tests/terminal.test.ts tests/pwa.test.ts",
    "test:legacy": "tsx --test tests/data.test.ts tests/recommendation.test.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "acorn": "^8.18.0",
    "cheerio": "^1.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
